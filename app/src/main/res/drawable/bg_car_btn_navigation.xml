<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/car_ripple">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/car_accent_emerald_pressed" />
                    <corners android:radius="@dimen/car_card_radius_large" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:startColor="@color/car_accent_emerald"
                        android:endColor="@color/car_accent_emerald_bright"
                        android:type="linear" />
                    <corners android:radius="@dimen/car_card_radius_large" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
