<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/car_ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/car_card_tile" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/car_accent_emerald" />
                    <corners android:radius="@dimen/car_rail_tile_radius" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/car_card_surface_elevated" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/car_card_tile_stroke" />
                    <corners android:radius="@dimen/car_rail_tile_radius" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/car_card_tile" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/car_card_tile_stroke" />
                    <corners android:radius="@dimen/car_rail_tile_radius" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
