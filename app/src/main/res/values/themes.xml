<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LocateShare" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.LocateShare" parent="Base.Theme.LocateShare" />

    <style name="Theme.LocateShare.FloatingDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Automotive Landscape Dark High-Contrast Theme -->
    <style name="Theme.LocateShare.CarLandscape" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/car_bg_dark</item>
        <item name="android:colorBackground">@color/car_bg_dark</item>
        <item name="android:textColorPrimary">@color/car_text_primary</item>
        <item name="android:textColorSecondary">@color/car_text_secondary</item>
        <item name="android:colorPrimary">@color/car_accent_green</item>
        <item name="android:colorAccent">@color/car_accent_green</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@color/car_bg_dark</item>
        <item name="android:navigationBarColor">@color/car_bg_dark</item>
    </style>
</resources>