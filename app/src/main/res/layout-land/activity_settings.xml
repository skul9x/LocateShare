<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:weightSum="100"
    android:background="#121212"
    android:padding="12dp">

    <!-- Left Column: Back button, Title & Add Favorite Form in ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="45"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:layout_marginEnd="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnBackSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⬅️ Quay lại"
                    android:backgroundTint="#555555"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚙️ Cài đặt"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="end"
                    android:layout_marginEnd="8dp" />
            </LinearLayout>

            <!-- Card Section: Add New Favorite -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➕ Thêm Địa Điểm Ưa Thích"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#E91E63"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etFavName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tên địa điểm (VD: Nhà, Công ty...)"
                    android:inputType="text"
                    android:background="@drawable/input_background"
                    android:backgroundTint="#333333"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etFavUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Link Google Maps"
                    android:inputType="textUri"
                    android:background="@drawable/input_background"
                    android:backgroundTint="#333333"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnAddFavorite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="➕ Thêm địa điểm"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Right Column: Favorites List -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="55"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="14dp"
        android:layout_marginStart="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ Danh sách Ưa thích"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FF9800"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFavorites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:clipToPadding="false" />
    </LinearLayout>

</LinearLayout>
