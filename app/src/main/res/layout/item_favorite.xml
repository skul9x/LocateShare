<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/car_card_surface_elevated"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Star Button (Large 56dp Touch Target) -->
        <ImageButton
            android:id="@+id/btnStar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đánh dấu mặc định"
            android:scaleType="centerInside" />

        <!-- Name + URL -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="10dp">

            <TextView
                android:id="@+id/tvFavName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/car_text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvFavUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/car_text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Edit Button (Large 52dp Touch Target) -->
        <ImageButton
            android:id="@+id/btnEdit"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sửa địa điểm"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/car_accent_green"
            android:scaleType="centerInside" />

        <!-- Delete Button (Large 52dp Touch Target) -->
        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Xóa địa điểm"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/car_status_disconnected"
            android:scaleType="centerInside"
            android:layout_marginStart="4dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
