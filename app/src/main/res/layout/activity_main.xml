<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/gradient_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LocateShare"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Powered by Supabase ⚡"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="48dp" />

        <Button
            android:id="@+id/btnPhoneMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 Chế độ Điện Thoại (Gửi)"
            android:padding="16dp"
            android:textSize="18sp"
            android:background="@drawable/rounded_button"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnCarMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚗 Chế độ Xe Hơi (Nhận)"
            android:padding="16dp"
            android:textSize="18sp"
            android:background="@drawable/rounded_button"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tự động mở chế độ:"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp"/>

        <RadioGroup
            android:id="@+id/rgDefaultMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <RadioButton
                android:id="@+id/rbNone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Không"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="16dp"/>

            <RadioButton
                android:id="@+id/rbPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Điện thoại"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="16dp"/>

            <RadioButton
                android:id="@+id/rbCar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xe hơi"
                android:textColor="#FFFFFF"/>
        </RadioGroup>

        <Button
            android:id="@+id/btnViewLogs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xem Logs (Báo lỗi)"
            android:layout_marginTop="48dp"
            android:backgroundTint="#FF5722"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>